# Supabase Credentials (PostgreSQL Database & Realtime WebSockets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Upstash Redis Credentials (Atomic Queue Locking & Fast Queue Cache)
VITE_UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
